{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/devices-ui", "destination": "/live-site/public/device-ui.html" },
    { "source": "/((?!api/).*)", "destination": "/live-site/public/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
